@using MicroFlows.Domain.Models
@inject FlowHistoryViewModel _vm

<style>
    td {
        padding-right: 4px;
    }
</style>

<h5 style="padding-top:20px">Flow Instance History</h5>

<table>
    <tr>
        <td>RefId:</td>
        <td>@Model.RefId</td>
    </tr>
    <tr>
        <td>ExternalId:</td>
        <td>@Model.ExternalId</td>
    </tr>
    <tr>
        <td>FlowTypeName:</td>
        <td>@Model.FlowTypeName</td>
    </tr>
</table>
@* RefId: @Model.RefId
<br/>
ExternalId: @Model.ExternalId
<br /> *@

<MudExpansionPanels MultiExpansion="true">
    @foreach (var line in _vm.GetLines())
    {
        <MudExpansionPanel Text=@line.Header>
            <FlowHistoryItem></FlowHistoryItem>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    [Parameter]
    public FlowStoreModel Model { get; set; }

    protected override void OnParametersSet()
    {
        _vm.Model = Model;
    }
}
