@page "/"

<style>
    form {
    display: flex; /* 2. display flex to the rescue */
    flex-direction: row;
    }

    label, input {
    display: block; /* 1. oh noes, my inputs are styled as block... */
    }
</style>

<PageTitle>Home</PageTitle>

<form>
    <MudTextField Value="Query.RefId" Label="RefId" ValueChanged="@RefIdChanged"
        Variant="Variant.Text" Margin="Margin.Dense" T="string"/>

    <MudTextField Value="Query.ExternalId" Label="ExternalId" ValueChanged="@ExternalIdChanged"
                  Variant="Variant.Text" Margin="Margin.Dense" T="string" />

    <MudTextField Value="Query.CorrelationId" Label="CorrelationId" ValueChanged="@CorrelationIdChanged"
                  Variant="Variant.Text" Margin="Margin.Dense" T="string" />


    <MudTextField @bind-Value="Status" Label="Status" Variant="Variant.Text" Margin="Margin.Dense"></MudTextField>
    <MudTextField @bind-Value="Name" Label="Flow Name" Variant="Variant.Text" Margin="Margin.Dense"></MudTextField>
    <MudTextField @bind-Value="Tag" Label="Tag" Variant="Variant.Text" Margin="Margin.Dense"></MudTextField>
    <MudTextField @bind-Value="Created" Label="Created" Variant="Variant.Text" Margin="Margin.Dense"></MudTextField>

    <MudDatePicker Editable=true Date="@Query.ModifiedFrom" DateChanged="@ModifiedChanged" Label="Modified"
        DateFormat="@DateFormat" Variant="Variant.Text" Margin="Margin.Dense"></MudDatePicker>

</form>

